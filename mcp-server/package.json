{
  "name": "@lamsuite/mcp-server",
  "version": "1.0.0",
  "description": "Model Context Protocol (MCP) Server for LamSuite Pharmacy & Retail Billing",
  "type": "module",
  "bin": {
    "lamsuite-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:http": "node dist/index.js --transport=http --port=3000",
    "start:mock": "node dist/index.js --mock",
    "start:http:mock": "node dist/index.js --transport=http --port=3000 --mock",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "inspect": "npx @modelcontextprotocol/inspector tsx src/index.ts"
  },
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "lamsuite",
    "billing",
    "pos",
    "pharmacy",
    "gst"
  ],
  "author": "LamStone Technologies",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "zod": "^3.24.2",
    "zod-to-json-schema": "^3.24.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/inspector": "^2.9.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "tsx": "^4.23.15",
    "typescript": "^5.5.4",
    "vitest": "^4.1.11"
  }
}
