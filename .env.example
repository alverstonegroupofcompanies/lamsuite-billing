# ==============================================================================
# LamSuite Billing - Production Environment Configuration
# ==============================================================================
# Copy this file to .env and configure values before starting the stack:
# cp .env.example .env
# Never commit your real .env file into source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Primary Domain & Subdomain Mapping
# ------------------------------------------------------------------------------
# Base domain (e.g., example.com, billing.yourcompany.com)
DOMAIN=example.com

# Subdomain prefixes (keep these centralized here)
SUBDOMAIN_API=api
SUBDOMAIN_WS=ws
SUBDOMAIN_PANEL=panel
SUBDOMAIN_MCP=mcp
SUBDOMAIN_APP=app
SUBDOMAIN_UPDATES=updates

# ------------------------------------------------------------------------------
# 2. Traefik Reverse Proxy & Let's Encrypt SSL
# ------------------------------------------------------------------------------
# Contact email for ACME Let's Encrypt certificate registration and expiration alerts
ACME_EMAIL=admin@example.com

# Traefik Dashboard Basic Auth (htpasswd format: user:bcrypt_hash)
# Generate with: echo $(htpasswd -nb admin your_password) | sed -e s/\\$/\\$\\$/g
TRAEFIK_DASHBOARD_AUTH=admin:$$2y$$05$$1vB8oIq9kQcZpEceL5cWcOu2w6EKn9gE7O1d1V1pT0qF1Z0J4jVKe

# ------------------------------------------------------------------------------
# 3. Laravel Core Application Settings
# ------------------------------------------------------------------------------
APP_NAME="LamSuite Billing"
APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=Asia/Kolkata

# Generate with: php artisan key:generate --show
APP_KEY=base64:u3x4yY9c8WqL12E0b7F6gA5hP4rZ3eQ2wV1mK0jD9s8=

# CORS Allowed Origins (Comma-separated override; defaults to panel and app subdomains)
CORS_ALLOWED_ORIGINS=https://panel.example.com,https://app.example.com,tauri://localhost

# ------------------------------------------------------------------------------
# 4. Database (MySQL 8.4 LTS)
# ------------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=lamsuite_billing
DB_USERNAME=lamsuite
DB_PASSWORD=ChangeThisSecureDbPassword_123!
DB_ROOT_PASSWORD=ChangeThisSecureDbRootPassword_456!

# ------------------------------------------------------------------------------
# 5. Redis Cache & Queue Broker
# ------------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=ChangeThisSecureRedisPassword_789!

# ------------------------------------------------------------------------------
# 6. Real-Time WebSockets (Laravel Reverb)
# ------------------------------------------------------------------------------
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=lamsuite_prod_01
REVERB_APP_KEY=lamsuite_reverb_key_prod
REVERB_APP_SECRET=ChangeThisReverbSecret_abc123!
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http

# ------------------------------------------------------------------------------
# 7. Model Context Protocol (MCP) Server
# ------------------------------------------------------------------------------
# MCP Authentication token required for SSE stream and messages over HTTP transport
MCP_AUTH_TOKEN=ChangeThisSecureMcpToken_xyz789!
# Default to read-only mode for LLM agent safety
MCP_READ_ONLY=true

# ------------------------------------------------------------------------------
# 8. Encrypted Off-Site Backups (S3 / R2 / MinIO)
# ------------------------------------------------------------------------------
BACKUP_ENCRYPTION_PASSPHRASE=ChangeThisGpgBackupEncryptionPassphrase_999!
BACKUP_S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
BACKUP_S3_BUCKET=lamsuite-backups
BACKUP_S3_REGION=us-east-1
BACKUP_S3_ACCESS_KEY=YOUR_S3_ACCESS_KEY
BACKUP_S3_SECRET_KEY=YOUR_S3_SECRET_KEY
BACKUP_RETENTION_DAYS=30
BACKUP_ALERT_WEBHOOK_URL=https://discord.com/api/webhooks/...

# ------------------------------------------------------------------------------
# 9. Mail Notification & SMTP Settings
# ------------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"
