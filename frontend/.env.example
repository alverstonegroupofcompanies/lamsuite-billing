# LamSuite Billing Frontend Environment Configuration

# Backend API base URL (Laravel backend server)
VITE_API_BASE_URL=http://127.0.0.1:8000

# Central Admin Portal URL (for centralized licensing)
VITE_PANEL_PORTAL_URL=https://app.example.com
VITE_ADMIN_PORTAL_URL=https://app.example.com

# Legacy v1 admin panel — the only host that serves /api/sync/pull. This is not the
# portal: pointing the migration wizard at VITE_ADMIN_PORTAL_URL fails as "Load failed".
VITE_LEGACY_API_URL=https://admin.example.com

# Default LAN Hub Port for peer-to-peer / multi-counter syncing
VITE_DEFAULT_LAN_PORT=8089
