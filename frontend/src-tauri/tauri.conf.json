{
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build -- --mode production",
    "devPath": "http://localhost:5173",
    "distDir": "../dist",
    "withGlobalTauri": true
  },
  "package": {
    "productName": "LamSuite-Billing",
    "version": "2.0.22"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "shell": {
        "all": true,
        "open": true
      },
      "dialog": {
        "all": true,
        "open": true,
        "save": true
      },
      "fs": {
        "all": true,
        "scope": ["**"]
      },
      "http": {
        "all": true,
        "request": true,
        "scope": ["https://*/*", "http://*/*"]
      },
      "window": {
        "all": true
      },
      "process": {
        "all": false,
        "relaunch": true
      }
    },
    "windows": [
      {
        "label": "main",
        "title": "LamSuite Billing",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "focus": false
      }
    ],
    "security": {
      "csp": null
    },
    "bundle": {
      "active": true,
      "identifier": "com.lamsuite.billing",
      "targets": ["nsis", "updater"],
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.ico",
        "icons/icon.icns"
      ],
      "windows": {
        "webviewInstallMode": {
          "type": "downloadBootstrapper"
        }
      }
    },
    "updater": {
      "active": true,
      "dialog": false,
      "endpoints": [
        "https://github.com/alverstonegroupofcompanies/lamsuite-billing/releases/latest/download/latest.json",
        "https://api.lamstonehealthcare.com/api/app/update/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk3ODg4M0E4N0UzRTM4MDYKUldRR09ENStxSU9JbDJpblJXQTV6am8zVDFuME1udVJkdUZXeExUSEF6aXNONDUvSE84YktXd3IK"
    }
  }
}
