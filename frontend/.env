# LamSuite Billing Frontend Environment Configuration

# Backend API base URL (Laravel backend server)
VITE_API_BASE_URL=http://127.0.0.1:8000

# Central Admin Portal URL (for cloud migrations and centralized licensing)
VITE_ADMIN_PORTAL_URL=https://admin.lamstonehealthcare.com

# Default LAN Hub Port for peer-to-peer / multi-counter syncing
VITE_DEFAULT_LAN_PORT=8089

